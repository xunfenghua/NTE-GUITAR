<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NTE-GUITAR-AnnouncementServer</AssemblyName>
    <RootNamespace>NteGuitar.AnnouncementServer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="announcement.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
